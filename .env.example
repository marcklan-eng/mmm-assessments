# ---- Required ----
# Random string: run `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Your app's URL, e.g. https://mmm-assessments.vercel.app (http://localhost:3000 locally)
NEXTAUTH_URL=http://localhost:3000

# ---- Prototype mode ----
# true = shows an "email only (demo)" sign-in so you can test without Google/Microsoft setup.
# Turn OFF before real candidates use the app.
DEMO_MODE=true

# ---- Storage (Upstash Redis from the Vercel Marketplace adds these automatically) ----
# Leave empty locally to store data in .data/db.json
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft sign-in (Azure portal > App registrations; "Personal + work accounts") ----
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# ---- Google Sheet results + evaluator access (Apps Script web app inside the Sheet) ----
# See apps-script/Code.gs. The URL ends in /exec.
SHEET_WEBHOOK_URL=
# Same password as SECRET in the Apps Script
SHEET_WEBHOOK_SECRET=

# Optional: extra evaluator emails (comma-separated) allowed into the dashboard
# in addition to everyone the Sheet is shared with.
ADMIN_EMAILS=

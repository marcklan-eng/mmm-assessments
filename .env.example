# Settings for the SEA app. In Google AI Studio: Settings → Secrets. Write "none" for anything you don't use.
# See MIGRATION-GOOGLE.md for where each value comes from.

# Storage: "firestore" on Google Cloud. (On Vercel, leave unset and connect Upstash Redis.)
STORAGE=firestore
# Cloud Storage bucket for uploaded images, audio and video.
MEDIA_BUCKET=none
# Only if your Firestore database isn't "(default)" or lives in another project.
FIRESTORE_DATABASE_ID=none
FIRESTORE_PROJECT_ID=none

# Sign-in
NEXTAUTH_URL=https://your-app-address
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=none
AZURE_AD_CLIENT_SECRET=none
AZURE_AD_TENANT_ID=none
# "true" lets anyone sign in with any email (testing only).
DEMO_MODE=false
ADMIN_EMAILS=none

# Google Sheets (Apps Script web apps)
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
QUESTIONS_WEBHOOK_URL=
QUESTIONS_WEBHOOK_SECRET=

# Optional: hours before an invite link expires (also settable on the dashboard).
LINK_EXPIRY_HOURS=none

# Only while moving from Vercel (remove afterwards): the old Upstash Redis and Vercel Blob.
OLD_KV_REST_API_URL=
OLD_KV_REST_API_TOKEN=
OLD_BLOB_READ_WRITE_TOKEN=none
# Old Vercel names: leave as "none" here (otherwise the app would keep using the old storage).
KV_REST_API_URL=none
KV_REST_API_TOKEN=none
UPSTASH_REDIS_REST_URL=none
UPSTASH_REDIS_REST_TOKEN=none
BLOB_READ_WRITE_TOKEN=none
